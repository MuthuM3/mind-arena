#!/usr/bin/env bash

set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
project_root="$(cd -- "${script_dir}/.." && pwd)"
sibling_binary="${project_root}/../codex-antigravity-automation/bin/agentflow"

if command -v agentflow >/dev/null 2>&1; then
  agentflow_binary="$(command -v agentflow)"
elif [[ -x "${sibling_binary}" ]]; then
  agentflow_binary="${sibling_binary}"
else
  echo "Agentflow was not found on PATH or at ${sibling_binary}." >&2
  exit 1
fi

command_name="${1:-help}"
if [[ $# -gt 0 ]]; then
  shift
fi

case "${command_name}" in
  help|version)
    exec "${agentflow_binary}" "${command_name}" "$@"
    ;;
  *)
    exec "${agentflow_binary}" "${command_name}" --work-dir "${project_root}" "$@"
    ;;
esac
