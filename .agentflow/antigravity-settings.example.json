      "command(git restore)",
      "command(sudo)",
      "command(ssh)",
      "command(scp)",
      "command(kubectl)",
      "command(terraform apply)",
      "command(terraform destroy)",
      "write_file(/Users/muthum/Work/mind-arena/.git)",
      "read_file(/Users/muthum/.ssh)",
      "write_file(/Users/muthum/.ssh)",
      "read_file(/Users/muthum/.aws)",
      "write_file(/Users/muthum/.aws)",
      "read_file(/Users/muthum/.kube)",
      "write_file(/Users/muthum/.kube)",
      "read_file(/Users/muthum/.config/gcloud)",
      "write_file(/Users/muthum/.config/gcloud)"
